# PostgreSQL. Use a dedicated, least-privilege application account.
# POSTGRES_PASSWORD must match the password in DATABASE_URL (used by docker-compose).
POSTGRES_PASSWORD=replace_me
DATABASE_URL="postgresql://nslv_app:replace_me@localhost:5432/nsvilla?schema=public"

NODE_ENV=development
SERVER_HOST=localhost
SERVER_PORT=3001
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Set to the number of trusted proxy hops in front of the API (1 behind nginx/Cloudflare). 0 = no proxy.
TRUST_PROXY=0

# Required in production. Use long, unique values from a secret manager.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

VILLA_NAME=NSVilla
VILLA_CURRENCY=GHS
VILLA_TIMEZONE=Africa/Accra
VILLA_COUNTRY=Ghana
VILLA_PHONE=+233000000000
VILLA_EMAIL=operations@example.com
VILLA_ADDRESS=Configure in production
VILLA_WEBSITE=https://www.nsvilla.com

# Required only for an intentional development seed; never use a known default.
ADMIN_DEFAULT_EMAIL=admin@example.test
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=replace-with-a-unique-development-password
