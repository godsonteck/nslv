{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["../../node_modules/@types", "./node_modules/@types"],
    "types": ["react", "react-dom", "node"]
  },
  "include": ["src/**/*"]
}
