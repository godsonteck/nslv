// ============================================
// NS LUXURY VILLA — Prisma Schema
// Production database schema
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  phone         String?
  avatarUrl     String?   @map("avatar_url")
  status        String    @default("ACTIVE") // ACTIVE | SUSPENDED | DEACTIVATED
  totpSecret    String?   @map("totp_secret")
  totpEnabled   Boolean   @default(false) @map("totp_enabled")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  userRoles     UserRole[]
  sessions      Session[]
  auditLogs     AuditLog[]
  settingsUpdated SystemSetting[] @relation("SettingUpdater")
  eventBookings EventBooking[]
  notifications Notification[]

  @@map("users")
}

// ──────────────────────────────────────────
// Roles & Permissions (RBAC)
// ──────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  code        String @unique
  module      String
  action      String
  description String

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedBy String?  @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ──────────────────────────────────────────
// Sessions
// ──────────────────────────────────────────

model Session {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  refreshTokenHash String   @map("refresh_token_hash")
  deviceInfo       String?  @map("device_info")
  ipAddress        String?  @map("ip_address")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ──────────────────────────────────────────
// Audit Logs
// ──────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  beforeData String?  @map("before_data") // JSON string
  afterData  String?  @map("after_data")  // JSON string
  ipAddress  String?  @map("ip_address")
  deviceInfo String?  @map("device_info")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ──────────────────────────────────────────
// System Settings
// ──────────────────────────────────────────

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   // JSON string
  category    String
  description String?
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updater User? @relation("SettingUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([category])
  @@map("system_settings")
}

// ──────────────────────────────────────────
// Room Types & Rooms
// ──────────────────────────────────────────

model RoomType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  basePrice   Decimal  @map("base_price")
  maxAdults   Int      @default(2) @map("max_adults")
  maxChildren Int      @default(0) @map("max_children")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  rooms       Room[]
  amenities   RoomTypeAmenity[]

  @@map("room_types")
}

model RoomAmenity {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String?
  category  String?  // e.g., 'comfort', 'entertainment', 'bathroom', 'view'
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  roomTypes RoomTypeAmenity[]

  @@map("room_amenities")
}

model RoomTypeAmenity {
  roomTypeId  String      @map("room_type_id")
  amenityId   String      @map("amenity_id")
  roomType    RoomType    @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity     RoomAmenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomTypeId, amenityId])
  @@map("room_type_amenities")
}

model Room {
  id           String       @id @default(uuid())
  number       String       @unique
  name         String?
  roomTypeId   String       @map("room_type_id")
  floor        Int?
  status       String       @default("AVAILABLE") // AVAILABLE | RESERVED | OCCUPIED | DIRTY | CLEANING | MAINTENANCE | OUT_OF_SERVICE
  notes        String?
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relations
  roomType     RoomType     @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  reservations Reservation[]
  checkIns     CheckIn[]
  checkOuts    CheckOut[]

  @@index([roomTypeId])
  @@index([status])
  @@map("rooms")
}

// ──────────────────────────────────────────
// Guests
// ──────────────────────────────────────────

model Guest {
  id              String   @id @default(uuid())
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  email           String?
  phone           String?
  address         String?
  city            String?
  country         String?
  idDocumentType  String?  @map("id_document_type") // PASSPORT | NATIONAL_ID | DRIVERS_LICENSE | VOTER_ID | GHANA_CARD | OTHER
  idDocumentNumber String? @map("id_document_number")
  dateOfBirth     DateTime? @map("date_of_birth")
  nationality     String?
  preferences     String?  // JSON string for guest preferences
  notes           String?
  isVip           Boolean  @default(false) @map("is_vip")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  reservations    ReservationGuest[]
  checkIns        CheckIn[]
  checkOuts       CheckOut[]
  folios          Folio[]
  payments        Payment[]

  @@index([email])
  @@index([phone])
  @@index([lastName, firstName])
  @@map("guests")
}

// ──────────────────────────────────────────
// Reservations
// ──────────────────────────────────────────

model Reservation {
  id              String   @id @default(uuid())
  confirmationNo  String   @unique @map("confirmation_no") // e.g., NSLV-20260807-0001
  bookingId       String?  @map("booking_id") // Links multi-room reservations from one request into a party
  roomId          String   @map("room_id")
  status          String   @default("PENDING") // PENDING | CONFIRMED | CHECKED_IN | CHECKED_OUT | CANCELLED | NO_SHOW
  source          String   @default("WALK_IN") // WALK_IN | PHONE | EMAIL | WEBSITE | WHATSAPP | OTA | REFERRAL | OTHER
  checkInDate     DateTime @map("check_in_date")
  checkOutDate    DateTime @map("check_out_date")
  adults          Int      @default(1)
  children        Int      @default(0)
  baseRate        Decimal  @map("base_rate")
  discountAmount  Decimal  @default(0) @map("discount_amount")
  discountReason  String?  @map("discount_reason")
  discountApprovedBy String? @map("discount_approved_by")
  taxAmount       Decimal  @default(0) @map("tax_amount")
  depositAmount   Decimal  @default(0) @map("deposit_amount")
  totalAmount     Decimal  @map("total_amount")
  specialRequests String?  @map("special_requests")
  notes           String?
  createdBy       String?  @map("created_by")
  cancelledBy     String?  @map("cancelled_by")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?  @map("cancel_reason")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  room            Room                 @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guests          ReservationGuest[]
  checkIns        CheckIn[]
  checkOuts       CheckOut[]
  folios          Folio[]
  payments        Payment[]

  @@index([roomId])
  @@index([status])
  @@index([bookingId])
  @@index([checkInDate])
  @@index([checkOutDate])
  @@index([confirmationNo])
  @@map("reservations")
}

model ReservationGuest {
  id            String      @id @default(uuid())
  reservationId String      @map("reservation_id")
  guestId       String      @map("guest_id")
  isPrimary     Boolean     @default(false) @map("is_primary")
  createdAt     DateTime    @default(now()) @map("created_at")

  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guest         Guest       @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([guestId])
  @@map("reservation_guests")
}

// ──────────────────────────────────────────
// Check-in / Check-out
// ──────────────────────────────────────────

model CheckIn {
  id              String   @id @default(uuid())
  reservationId   String   @map("reservation_id")
  roomId          String   @map("room_id")
  guestId         String   @map("guest_id")
  checkedInBy     String   @map("checked_in_by")
  actualCheckIn   DateTime @default(now()) @map("actual_check_in")
  idVerified      Boolean  @default(false) @map("id_verified")
  idDocumentType  String?  @map("id_document_type")
  idDocumentNumber String? @map("id_document_number")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room            Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guest           Guest       @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@unique([reservationId])
  @@map("check_ins")
}

model CheckOut {
  id                String   @id @default(uuid())
  reservationId     String   @map("reservation_id")
  roomId            String   @map("room_id")
  guestId           String   @map("guest_id")
  checkedOutBy      String   @map("checked_out_by")
  actualCheckOut    DateTime @default(now()) @map("actual_check_out")
  roomCondition     String   @default("DIRTY") // DIRTY | CLEAN | DAMAGED
  finalBalance      Decimal  @default(0) @map("final_balance")
  paymentMethod     String?  @map("payment_method")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  reservation       Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room              Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guest             Guest       @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@unique([reservationId])
  @@map("check_outs")
}

// ──────────────────────────────────────────
// Guest Folios & Payments (Phase 4 foundation)
// ──────────────────────────────────────────

model Folio {
  id              String   @id @default(uuid())
  reservationId   String   @unique @map("reservation_id")
  guestId         String   @map("guest_id")
  status          String   @default("OPEN") // OPEN | CLOSED | DISPUTED
  balance         Decimal  @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  closedAt        DateTime? @map("closed_at")

  // Relations
  reservation     Reservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guest           Guest          @relation(fields: [guestId], references: [id], onDelete: Restrict)
  items           FolioItem[]
  payments        Payment[]

  @@index([reservationId])
  @@index([guestId])
  @@index([status])
  @@map("folios")
}

model FolioItem {
  id              String   @id @default(uuid())
  folioId         String   @map("folio_id")
  type            String   // ACCOMMODATION | RESTAURANT | BAR | POOL | SERVICE | DISCOUNT | TAX | PAYMENT | REFUND | ADJUSTMENT | DEPOSIT
  description     String
  amount          Decimal
  quantity        Int      @default(1)
  unitPrice       Decimal  @map("unit_price")
  department      String   // FRONT_DESK | RESTAURANT | BAR | POOL | HOUSEKEEPING | MAINTENANCE | MANAGEMENT | ADMINISTRATION
  referenceId     String?  @map("reference_id") // e.g., order_id, payment_id
  referenceType   String?  @map("reference_type") // ORDER | PAYMENT | RESERVATION | MANUAL
  postedBy        String   @map("posted_by")
  postedAt        DateTime @default(now()) @map("posted_at")
  voidedAt        DateTime? @map("voided_at")
  voidedBy        String?  @map("voided_by")
  voidReason      String?  @map("void_reason")

  // Relations
  folio           Folio    @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
  @@index([type])
  @@index([department])
  @@index([referenceId])
  @@map("folio_items")
}

model Payment {
  id              String   @id @default(uuid())
  reservationId   String?  @map("reservation_id")
  guestId         String?  @map("guest_id")
  folioId         String?  @map("folio_id")
  amount          Decimal
  currency        String   @default("GHS")
  method          String   // CASH | MOBILE_MONEY | CARD | BANK_TRANSFER | ROOM_CHARGE | OTHER
  reference       String?  // Transaction reference from payment provider
  source          String?  // RESTAURANT_ORDER | BAR_ORDER | POOL_TRANSACTION | FOLIO
  sourceId        String?  @map("source_id")
  originalPaymentId String? @map("original_payment_id")
  idempotencyKey  String?  @unique @map("idempotency_key")
  status          String   @default("COMPLETED") // PENDING | COMPLETED | FAILED | REFUNDED | PARTIALLY_REFUNDED
  type            String   @default("PAYMENT") // PAYMENT | REFUND | DEPOSIT | ADJUSTMENT
  description     String?
  processedBy     String   @map("processed_by")
  processedAt     DateTime @default(now()) @map("processed_at")
  voidedAt        DateTime? @map("voided_at")
  voidedBy        String?  @map("voided_by")
  voidReason      String?  @map("void_reason")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  reservation     Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest           Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)
  folio           Folio?       @relation(fields: [folioId], references: [id], onDelete: SetNull)
  originalPayment Payment?     @relation("PaymentRefunds", fields: [originalPaymentId], references: [id], onDelete: Restrict)
  refunds         Payment[]    @relation("PaymentRefunds")

  @@index([reservationId])
  @@index([guestId])
  @@index([folioId])
  @@index([status])
  @@index([processedAt])
  @@index([source, sourceId])
  @@index([originalPaymentId])
  @@map("payments")
}

// ──────────────────────────────────────────
// Categories
// ──────────────────────────────────────────

model ItemCategory {
  id          String   @id @default(uuid())
  name        String
  type        String   // RESTAURANT | BAR | POOL | INVENTORY | EXPENDITURE
  description String?
  color       String?  // Optional hex color for UI display
  order       Int      @default(0) // Sort order
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([name, type])
  @@index([type])
  @@index([isActive])
  @@map("item_categories")
}

// ──────────────────────────────────────────
// POS — Restaurant
// ──────────────────────────────────────────

model RestaurantItem {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String   // STARTERS | MAINS | DESSERTS | BEVERAGES | SPECIALS
  description String?
  price       Decimal
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orderItems  RestaurantOrderItem[]
  recipes     Recipe[]

  @@index([category])
  @@map("restaurant_items")
}

model RestaurantOrder {
  id            String   @id @default(uuid())
  orderNo       String   @unique @map("order_no") // e.g. RES-20260809-001
  guestId       String?  @map("guest_id")
  roomId        String?  @map("room_id")
  tableNo       String?  @map("table_no")
  status        String   @default("PENDING") // PENDING | PREPARING | SERVED | COMPLETED | CANCELLED
  totalAmount   Decimal  @map("total_amount")
  paymentMethod String   @default("ROOM_CHARGE") // ROOM_CHARGE | CASH | CARD | MOBILE_MONEY
  paymentStatus String   @default("PENDING") // PENDING | PAID | CHARGED_TO_FOLIO
  folioItemId   String?  @map("folio_item_id")
  idempotencyKey String? @unique @map("idempotency_key")
  notes         String?
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orderItems    RestaurantOrderItem[]

  @@index([guestId])
  @@index([roomId])
  @@index([status])
  @@index([createdAt])
  @@map("restaurant_orders")
}

model RestaurantOrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  itemId      String   @map("item_id")
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price")
  totalPrice  Decimal  @map("total_price")
  notes       String?

  order       RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item        RestaurantItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([itemId])
  @@map("restaurant_order_items")
}

// ──────────────────────────────────────────
// POS — Bar
// ──────────────────────────────────────────

model BarItem {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String   // COCKTAILS | WINES | BEERS | SPIRITS | SOFT_DRINKS | SNACKS
  description String?
  price       Decimal
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orderItems  BarOrderItem[]
  recipes     Recipe[]

  @@index([category])
  @@map("bar_items")
}

model BarOrder {
  id            String   @id @default(uuid())
  orderNo       String   @unique @map("order_no") // e.g. BAR-20260809-001
  guestId       String?  @map("guest_id")
  roomId        String?  @map("room_id")
  status        String   @default("COMPLETED") // PENDING | SERVED | COMPLETED | CANCELLED
  totalAmount   Decimal  @map("total_amount")
  paymentMethod String   @default("ROOM_CHARGE") // ROOM_CHARGE | CASH | CARD | MOBILE_MONEY
  paymentStatus String   @default("PENDING") // PENDING | PAID | CHARGED_TO_FOLIO
  folioItemId   String?  @map("folio_item_id")
  idempotencyKey String? @unique @map("idempotency_key")
  notes         String?
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orderItems    BarOrderItem[]

  @@index([guestId])
  @@index([roomId])
  @@index([status])
  @@index([createdAt])
  @@map("bar_orders")
}

model BarOrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  itemId      String   @map("item_id")
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price")
  totalPrice  Decimal  @map("total_price")
  notes       String?

  order       BarOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item        BarItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([itemId])
  @@map("bar_order_items")
}

// ──────────────────────────────────────────
// POS — Pool
// ──────────────────────────────────────────

model PoolService {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String   // DAY_PASS | CABANA_RENTAL | TOWEL_RENTAL | POOL_SNACKS | BEVERAGES
  description String?
  price       Decimal
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  transactions PoolTransaction[]
  recipes      Recipe[]

  @@index([category])
  @@map("pool_services")
}

model PoolTransaction {
  id            String   @id @default(uuid())
  transactionNo String   @unique @map("transaction_no") // e.g. POL-20260809-001
  guestId       String?  @map("guest_id")
  roomId        String?  @map("room_id")
  serviceId     String   @map("service_id")
  quantity      Int      @default(1)
  unitPrice     Decimal  @map("unit_price")
  totalAmount   Decimal  @map("total_amount")
  paymentMethod String   @default("ROOM_CHARGE") // ROOM_CHARGE | CASH | CARD | MOBILE_MONEY
  paymentStatus String   @default("PENDING") // PENDING | PAID | CHARGED_TO_FOLIO
  folioItemId   String?  @map("folio_item_id")
  idempotencyKey String? @unique @map("idempotency_key")
  notes         String?
  processedBy   String   @map("processed_by")
  createdAt     DateTime @default(now()) @map("created_at")

  service       PoolService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([guestId])
  @@index([roomId])
  @@index([serviceId])
  @@index([createdAt])
  @@map("pool_transactions")
}

// Pool attendants record attendance only. Pool services and payments remain
// separate administrative workflows and are never created at the entry desk.
model PoolAttendance {
  id           String   @id @default(uuid())
  visitorName  String   @map("visitor_name")
  phone        String?
  partySize    Int      @default(1) @map("party_size")
  notes        String?
  recordedBy   String   @map("recorded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("pool_attendance")
}

model Expense {
  id          String   @id @default(uuid())
  expenseNo   String   @unique @map("expense_no") // e.g. EXP-20260810-ABC123
  category    String // UTILITIES | SUPPLIES | MAINTENANCE | STAFF | MARKETING | FOOD | BEVERAGES | OTHER
  description String
  amount      Decimal
  incurredOn  DateTime @map("incurred_on")
  paymentMethod String? @map("payment_method") // CASH | CARD | MOBILE_MONEY | BANK_TRANSFER
  vendor      String?
  receiptRef  String?  @map("receipt_ref")
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy  String?  @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  notes       String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([status])
  @@index([incurredOn])
  @@map("expenses")
}

model DailyClose {
  id           String   @id @default(uuid())
  businessDate DateTime @unique @map("business_date")
  openingCash  Decimal  @map("opening_cash")
  cashPayments Decimal  @map("cash_payments")
  cashRefunds  Decimal  @map("cash_refunds")
  cashExpenses Decimal  @map("cash_expenses")
  expectedCash Decimal  @map("expected_cash")
  actualCash   Decimal  @map("actual_cash")
  variance     Decimal
  varianceNote String?  @map("variance_note")
  closedBy     String   @map("closed_by")
  closedAt     DateTime @default(now()) @map("closed_at")

  @@map("daily_closes")
}

model InventoryItem {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  category    String // RESTAURANT | BAR | POOL | HOUSEKEEPING | MAINTENANCE | OFFICE
  unit        String // pcs | bottles | kg | liters | packs | boxes
  quantity    Int      @default(0)
  minQuantity Int      @default(0) @map("min_quantity")
  costPrice   Decimal? @map("cost_price")
  isActive    Boolean  @default(true) @map("is_active")
  notes       String?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  movements   InventoryMovement[]
  recipeItems RecipeItem[]

  @@index([category])
  @@index([isActive])
  @@map("inventory_items")
}

// Append-only stock ledger. The current quantity is a projection that is
// updated in the same transaction as each recorded movement.
model InventoryMovement {
  id              String        @id @default(uuid())
  inventoryItemId String        @map("inventory_item_id")
  type            String
  quantityChange  Int           @map("quantity_change")
  quantityBefore  Int           @map("quantity_before")
  quantityAfter   Int           @map("quantity_after")
  reason          String?
  recordedBy      String?       @map("recorded_by")
  referenceId     String?       @map("reference_id")
  referenceType   String?       @map("reference_type")
  recipeItemId    String?       @map("recipe_item_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, createdAt])
  @@index([type, createdAt])
  @@unique([referenceId, recipeItemId])
  @@map("inventory_movements")
}

// A sellable item may have zero or more historical recipes. Only one active
// recipe is used when a sale is finalised; inactive recipes preserve history.
model Recipe {
  id               String       @id @default(uuid())
  restaurantItemId String?      @map("restaurant_item_id")
  barItemId        String?      @map("bar_item_id")
  poolServiceId    String?      @map("pool_service_id")
  name             String
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  restaurantItem RestaurantItem? @relation(fields: [restaurantItemId], references: [id], onDelete: Restrict)
  barItem        BarItem?        @relation(fields: [barItemId], references: [id], onDelete: Restrict)
  poolService    PoolService?    @relation(fields: [poolServiceId], references: [id], onDelete: Restrict)
  items          RecipeItem[]

  @@index([restaurantItemId, isActive])
  @@index([barItemId, isActive])
  @@index([poolServiceId, isActive])
  @@map("recipes")
}

model RecipeItem {
  id              String        @id @default(uuid())
  recipeId        String        @map("recipe_id")
  inventoryItemId String        @map("inventory_item_id")
  quantity        Decimal
  unit            String
  // Multiplies recipe quantity into the inventory item's integer base unit
  // (e.g. 0.30 kg × 1000 = 300 g).
  conversionFactor Decimal      @default(1) @map("conversion_factor")
  createdAt       DateTime      @default(now()) @map("created_at")

  recipe          Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([recipeId, inventoryItemId])
  @@map("recipe_items")
}

// ──────────────────────────────────────────
// Events
// ──────────────────────────────────────────

model EventSpace {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  location     String?
  capacity     Int      @default(0)
  pricePerHour Float    @default(0) @map("price_per_hour")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  bookings EventBooking[]

  @@map("event_spaces")
}

model EventBooking {
  id           String    @id @default(uuid())
  title        String
  description  String?
  eventSpaceId String?   @map("event_space_id")
  startAt      DateTime  @map("start_at")
  endAt        DateTime  @map("end_at")
  status       String    @default("CONFIRMED") // PLANNED | CONFIRMED | COMPLETED | CANCELLED
  guestCount   Int       @default(0) @map("guest_count")
  contactName  String?   @map("contact_name")
  contactPhone String?   @map("contact_phone")
  contactEmail String?   @map("contact_email")
  notes        String?
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  eventSpace EventSpace? @relation(fields: [eventSpaceId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([startAt])
  @@index([status])
  @@index([eventSpaceId])
  @@map("event_bookings")
}

// ──────────────────────────────────────────
// Branding & Theme Configuration
// ──────────────────────────────────────────

model BrandingTheme {
  id              String   @id @default(uuid())
  villaName       String   @default("NS Luxury Villa") @map("villa_name")
  villaTagline    String   @default("Property Operations") @map("villa_tagline")
  logoUrl         String?  @db.Text @map("logo_url")
  loginBgUrl      String?  @db.Text @map("login_bg_url")
  
  // Primary brand colors
  primaryColor    String   @default("#174b59") @map("primary_color")
  secondaryColor  String   @default("#b18a55") @map("secondary_color")
  accentColor     String   @default("#d9bd91") @map("accent_color")
  
  // UI Colors
  bgColor         String   @default("#f5f6f4") @map("bg_color")
  textColor       String   @default("#14232b") @map("text_color")
  textMuted       String   @default("#7a858a") @map("text_muted")
  borderColor     String   @default("#e5e8e5") @map("border_color")
  
  // Status colors
  successColor    String   @default("#2d8a68") @map("success_color")
  warningColor    String   @default("#d97706") @map("warning_color")
  errorColor      String   @default("#dc2626") @map("error_color")
  infoColor       String   @default("#0284c7") @map("info_color")
  
  // Typography
  fontFamily      String   @default("system-ui, -apple-system, sans-serif") @map("font_family")
  headingFont     String   @default("Manrope, sans-serif") @map("heading_font")
  
  // Custom CSS
  customCss       String?  @map("custom_css") // Additional custom CSS
  
  // Settings
  useCustomLogin  Boolean  @default(false) @map("use_custom_login")
  enableDarkMode  Boolean  @default(false) @map("enable_dark_mode")
  
  // Metadata
  updatedBy       String?  @map("updated_by")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("branding_themes")
}

// ──────────────────────────────────────────
// Notifications
// ──────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   // RESERVATION, PAYMENT, ALERT, SYSTEM, INFO
  title     String
  message   String
  priority  String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  data      String?  // JSON payload for action context
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}
