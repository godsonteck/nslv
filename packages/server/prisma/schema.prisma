// ============================================
// NS LUXURY VILLA — Prisma Schema
// Production database schema
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────
// Users & Authentication
// ──────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  phone         String?
  avatarUrl     String?   @map("avatar_url")
  status        String    @default("ACTIVE") // ACTIVE | SUSPENDED | DEACTIVATED
  totpSecret    String?   @map("totp_secret")
  totpEnabled   Boolean   @default(false) @map("totp_enabled")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  userRoles     UserRole[]
  sessions      Session[]
  auditLogs     AuditLog[]
  settingsUpdated SystemSetting[] @relation("SettingUpdater")

  @@map("users")
}

// ──────────────────────────────────────────
// Roles & Permissions (RBAC)
// ──────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  code        String @unique
  module      String
  action      String
  description String

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedBy String?  @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ──────────────────────────────────────────
// Sessions
// ──────────────────────────────────────────

model Session {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  refreshTokenHash String   @map("refresh_token_hash")
  deviceInfo       String?  @map("device_info")
  ipAddress        String?  @map("ip_address")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ──────────────────────────────────────────
// Audit Logs
// ──────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  beforeData String?  @map("before_data") // JSON string
  afterData  String?  @map("after_data")  // JSON string
  ipAddress  String?  @map("ip_address")
  deviceInfo String?  @map("device_info")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ──────────────────────────────────────────
// System Settings
// ──────────────────────────────────────────

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   // JSON string
  category    String
  description String?
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updater User? @relation("SettingUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([category])
  @@map("system_settings")
}

// ──────────────────────────────────────────
// Room Types & Rooms
// ──────────────────────────────────────────

model RoomType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  basePrice   Decimal  @map("base_price")
  maxAdults   Int      @default(2) @map("max_adults")
  maxChildren Int      @default(0) @map("max_children")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  rooms       Room[]
  amenities   RoomTypeAmenity[]

  @@map("room_types")
}

model RoomAmenity {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String?
  category  String?  // e.g., 'comfort', 'entertainment', 'bathroom', 'view'
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  roomTypes RoomTypeAmenity[]

  @@map("room_amenities")
}

model RoomTypeAmenity {
  roomTypeId  String      @map("room_type_id")
  amenityId   String      @map("amenity_id")
  roomType    RoomType    @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity     RoomAmenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomTypeId, amenityId])
  @@map("room_type_amenities")
}

model Room {
  id           String       @id @default(uuid())
  number       String       @unique
  name         String?
  roomTypeId   String       @map("room_type_id")
  floor        Int?
  status       String       @default("AVAILABLE") // AVAILABLE | RESERVED | OCCUPIED | DIRTY | CLEANING | MAINTENANCE | OUT_OF_SERVICE
  notes        String?
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relations
  roomType     RoomType     @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  reservations Reservation[]
  checkIns     CheckIn[]
  checkOuts    CheckOut[]

  @@index([roomTypeId])
  @@index([status])
  @@map("rooms")
}

// ──────────────────────────────────────────
// Guests
// ──────────────────────────────────────────

model Guest {
  id              String   @id @default(uuid())
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  email           String?
  phone           String?
  address         String?
  city            String?
  country         String?
  idDocumentType  String?  @map("id_document_type") // PASSPORT | NATIONAL_ID | DRIVERS_LICENSE | VOTER_ID | GHANA_CARD | OTHER
  idDocumentNumber String? @map("id_document_number")
  dateOfBirth     DateTime? @map("date_of_birth")
  nationality     String?
  preferences     String?  // JSON string for guest preferences
  notes           String?
  isVip           Boolean  @default(false) @map("is_vip")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  reservations    ReservationGuest[]
  checkIns        CheckIn[]
  checkOuts       CheckOut[]
  folios          Folio[]
  payments        Payment[]

  @@index([email])
  @@index([phone])
  @@index([lastName, firstName])
  @@map("guests")
}

// ──────────────────────────────────────────
// Reservations
// ──────────────────────────────────────────

model Reservation {
  id              String   @id @default(uuid())
  confirmationNo  String   @unique @map("confirmation_no") // e.g., NSLV-20260807-0001
  roomId          String   @map("room_id")
  status          String   @default("PENDING") // PENDING | CONFIRMED | CHECKED_IN | CHECKED_OUT | CANCELLED | NO_SHOW
  source          String   @default("WALK_IN") // WALK_IN | PHONE | EMAIL | WEBSITE | WHATSAPP | OTA | REFERRAL | OTHER
  checkInDate     DateTime @map("check_in_date")
  checkOutDate    DateTime @map("check_out_date")
  adults          Int      @default(1)
  children        Int      @default(0)
  baseRate        Decimal  @map("base_rate")
  discountAmount  Decimal  @default(0) @map("discount_amount")
  taxAmount       Decimal  @default(0) @map("tax_amount")
  depositAmount   Decimal  @default(0) @map("deposit_amount")
  totalAmount     Decimal  @map("total_amount")
  specialRequests String?  @map("special_requests")
  notes           String?
  createdBy       String?  @map("created_by")
  cancelledBy     String?  @map("cancelled_by")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?  @map("cancel_reason")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  room            Room                 @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guests          ReservationGuest[]
  checkIns        CheckIn[]
  checkOuts       CheckOut[]
  folios          Folio[]
  payments        Payment[]

  @@index([roomId])
  @@index([status])
  @@index([checkInDate])
  @@index([checkOutDate])
  @@index([confirmationNo])
  @@map("reservations")
}

model ReservationGuest {
  id            String      @id @default(uuid())
  reservationId String      @map("reservation_id")
  guestId       String      @map("guest_id")
  isPrimary     Boolean     @default(false) @map("is_primary")
  createdAt     DateTime    @default(now()) @map("created_at")

  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guest         Guest       @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([guestId])
  @@map("reservation_guests")
}

// ──────────────────────────────────────────
// Check-in / Check-out
// ──────────────────────────────────────────

model CheckIn {
  id              String   @id @default(uuid())
  reservationId   String   @map("reservation_id")
  roomId          String   @map("room_id")
  guestId         String   @map("guest_id")
  checkedInBy     String   @map("checked_in_by")
  actualCheckIn   DateTime @default(now()) @map("actual_check_in")
  idVerified      Boolean  @default(false) @map("id_verified")
  idDocumentType  String?  @map("id_document_type")
  idDocumentNumber String? @map("id_document_number")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room            Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guest           Guest       @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@unique([reservationId])
  @@map("check_ins")
}

model CheckOut {
  id                String   @id @default(uuid())
  reservationId     String   @map("reservation_id")
  roomId            String   @map("room_id")
  guestId           String   @map("guest_id")
  checkedOutBy      String   @map("checked_out_by")
  actualCheckOut    DateTime @default(now()) @map("actual_check_out")
  roomCondition     String   @default("DIRTY") // DIRTY | CLEAN | DAMAGED
  finalBalance      Decimal  @default(0) @map("final_balance")
  paymentMethod     String?  @map("payment_method")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  reservation       Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room              Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guest             Guest       @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@unique([reservationId])
  @@map("check_outs")
}

// ──────────────────────────────────────────
// Guest Folios & Payments (Phase 4 foundation)
// ──────────────────────────────────────────

model Folio {
  id              String   @id @default(uuid())
  reservationId   String   @map("reservation_id")
  guestId         String   @map("guest_id")
  status          String   @default("OPEN") // OPEN | CLOSED | DISPUTED
  balance         Decimal  @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  closedAt        DateTime? @map("closed_at")

  // Relations
  reservation     Reservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guest           Guest          @relation(fields: [guestId], references: [id], onDelete: Restrict)
  items           FolioItem[]
  payments        Payment[]

  @@index([reservationId])
  @@index([guestId])
  @@index([status])
  @@map("folios")
}

model FolioItem {
  id              String   @id @default(uuid())
  folioId         String   @map("folio_id")
  type            String   // ACCOMMODATION | RESTAURANT | BAR | POOL | SERVICE | DISCOUNT | TAX | PAYMENT | REFUND | ADJUSTMENT | DEPOSIT
  description     String
  amount          Decimal
  quantity        Int      @default(1)
  unitPrice       Decimal  @map("unit_price")
  department      String   // FRONT_DESK | RESTAURANT | BAR | POOL | HOUSEKEEPING | MAINTENANCE | MANAGEMENT | ADMINISTRATION
  referenceId     String?  @map("reference_id") // e.g., order_id, payment_id
  referenceType   String?  @map("reference_type") // ORDER | PAYMENT | RESERVATION | MANUAL
  postedBy        String   @map("posted_by")
  postedAt        DateTime @default(now()) @map("posted_at")
  voidedAt        DateTime? @map("voided_at")
  voidedBy        String?  @map("voided_by")
  voidReason      String?  @map("void_reason")

  // Relations
  folio           Folio    @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
  @@index([type])
  @@index([department])
  @@index([referenceId])
  @@map("folio_items")
}

model Payment {
  id              String   @id @default(uuid())
  reservationId   String?  @map("reservation_id")
  guestId         String?  @map("guest_id")
  folioId         String?  @map("folio_id")
  amount          Decimal
  currency        String   @default("GHS")
  method          String   // CASH | MOBILE_MONEY | CARD | BANK_TRANSFER | ROOM_CHARGE | OTHER
  reference       String?  // Transaction reference from payment provider
  status          String   @default("COMPLETED") // PENDING | COMPLETED | FAILED | REFUNDED | PARTIALLY_REFUNDED
  type            String   @default("PAYMENT") // PAYMENT | REFUND | DEPOSIT | ADJUSTMENT
  description     String?
  processedBy     String   @map("processed_by")
  processedAt     DateTime @default(now()) @map("processed_at")
  voidedAt        DateTime? @map("voided_at")
  voidedBy        String?  @map("voided_by")
  voidReason      String?  @map("void_reason")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  reservation     Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest           Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)
  folio           Folio?       @relation(fields: [folioId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([guestId])
  @@index([folioId])
  @@index([status])
  @@index([processedAt])
  @@map("payments")
}
