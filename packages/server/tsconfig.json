{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // The Vercel function entrypoint (`api/index.js`) is CommonJS and loads
    // this compiled application with `require`. Emit matching CommonJS output
    // so Node does not attempt to resolve extensionless ESM directory imports.
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],
    "declaration": false,
    "declarationMap": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "prisma"]
}


